[Unit]
Description=autopxe single-binary PXE deployment service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/autopxe -config /etc/autopxe/config.yaml
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/autopxe
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
