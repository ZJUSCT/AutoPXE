#!ipxe
prompt --key 0x02 --timeout 3000 Press Ctrl-B for the iPXE command line... && shell ||
dhcp
echo iPXE chainloading boot.ipxe from ${next-server}
chain http://${next-server}/boot.ipxe?mac=${mac:hexhyp} || goto failed
echo Chainload succeeded

:failed
echo Chainload FAILED
prompt --timeout 60 Press any key to reboot
reboot
