# Network configuration for dnsmasq
DNSMASQ_INTERFACE=eth0
DHCP_RANGE=192.168.1.100,192.168.1.200,255.255.255.0,12h
GATEWAY_IP=192.168.1.1

# IPA downloader settings
IPA_FLAVOR=centos9
IPA_BRANCH=master
IPA_BASEURI=https://tarballs.opendev.org/openstack/ironic-python-agent/dib

# Disk images directory (relative to compose.yml)
IMAGES_DIR=./images
