#!ipxe

set pxe-server 192.168.100.1
set fakonic-host 192.168.100.1

echo === pxe-cluster: Starting deployment ===
echo Kernel:   http://${pxe-server}/ipa.kernel
echo Initrd:   http://${pxe-server}/ipa.initramfs
echo Fakonic:  http://${fakonic-host}:6385

kernel http://${pxe-server}/ipa.kernel console=ttyS0,115200 ipa-api-url=http://${fakonic-host}:6385 ipa-insecure=1 system_boot_mode=bios ip=dhcp initrd=ipa.initramfs
initrd http://${pxe-server}/ipa.initramfs
boot
